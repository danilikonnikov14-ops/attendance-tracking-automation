FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .
COPY config/ ./config/
COPY routes/ ./routes/
COPY services/ ./services/
COPY static/ ./static/
COPY templates/ ./templates/

ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=app.py

EXPOSE 5001

CMD ["python", "app.py"]